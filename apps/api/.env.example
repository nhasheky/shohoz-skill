# Shohoz Skill API
# Local Postgres (adjust to your dev DB). Production uses a managed instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shohoz_skill?schema=public"

# JWT
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Port
PORT=4000

# Gateway mock URLs (bKash/Nagad/SSLCommerz sandbox)
BKASH_SANDBOX_URL="https://sandbox.bkash.com"
SSLCOMMERZ_SANDBOX_URL="https://sandbox.sslcommerz.com"

# Steadfast courier (hardcopy delivery)
STEADFAST_BASE_URL="https://portal.packzy.com/api/v1"
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""

# Order notification inbox
ADMIN_EMAIL="nazmulhasanasheky@gmail.com"
