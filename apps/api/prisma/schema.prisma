// Shohoz Skill — data model. Mirrors the frontend domain types (src/lib/types.ts).
// Preview of the schema for the Postgres backend. `prisma migrate dev` once DB URL is set.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Auth & identity ───────────────────────────────────────────────
model User {
  id       String     @id @default(cuid())
  name     String
  nameBn   String?
  email    String?    @unique
  phone    String     @unique
  password String? // only if email+password login is enabled (otherwise OTP)
  role     Role       @default(STUDENT)
  status   UserStatus @default(ACTIVE)
  verified Boolean    @default(false)
  joinedAt DateTime   @default(now())

  devices       DeviceSession[]
  enrollments   Enrollment[]
  orders        Order[]
  examAttempts  ExamAttempt[]
  reviews       Review[]
  progressItems ProgressItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

// OTP login codes (hashed, single-use)
model OtpCode {
  id        String     @id @default(cuid())
  phone     String
  codeHash  String
  purpose   OtpPurpose @default(LOGIN)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([phone, purpose])
}

enum OtpPurpose {
  LOGIN
  REGISTER
  RESET
}

// Device-limit (max 2 premium logins)
model DeviceSession {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  deviceName String
  browser    String?
  os         String?
  ip         String?
  tokenJti   String?  @unique // JWT ID for revoking the session
  lastActive DateTime @default(now())
  current    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, lastActive])
}

// ─── Catalogue ─────────────────────────────────────────────────────
model Course {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  title                 String
  titleBn               String?
  tagline               String
  description           String   @db.Text
  category              String
  categoryBn            String?
  level                 String
  durationLabel         String
  totalHours            Int      @default(0)
  lectures              Int      @default(0)
  quizzes               Int      @default(0)
  articles              Int      @default(0)
  resources             Int      @default(0)
  students              Int      @default(0)
  rating                Float    @default(0)
  reviewCount           Int      @default(0)
  certificate           Boolean  @default(false)
  featured              Boolean  @default(false)
  published             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  seo                   Json?
  thumbnailUrl          String?
  learningOutcomes      String[] @default([])
  requirements          String[] @default([])
  whoIsFor              String[] @default([])
  faq                   Json?
  // Payment methods this product may override (empty = platform default).
  allowedPaymentMethods String[] @default([])
  // Admin-picked "you may also like" items: [{ type, id }]. Empty = auto-suggest.
  suggested             Json?

  prices       CoursePrice[]
  curriculum   CurriculumSection[]
  instructor   Instructor?         @relation(fields: [instructorId], references: [id])
  instructorId String?

  @@index([published, category])
}

// AccessDuration → price map
model CoursePrice {
  id             String @id @default(cuid())
  course         Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId       String
  duration       String // LIFETIME | 1_MONTH | 2_MONTHS | 3_MONTHS | 6_MONTHS
  amount         Int
  originalAmount Int?

  @@unique([courseId, duration])
}

model CurriculumSection {
  id        String   @id @default(cuid())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  title     String
  sortOrder Int      @default(0)
  lessons   Lesson[]

  @@index([courseId])
}

model Lesson {
  id              String            @id @default(cuid())
  section         CurriculumSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId       String
  title           String
  durationMinutes Int               @default(0)
  sourceKind      String            @default("youtube") // youtube | direct
  sourceId        String // youtubeId or hlsUrl
  preview         Boolean           @default(false)
  sortOrder       Int               @default(0)
}

model Instructor {
  id            String   @id @default(cuid())
  userId        String?  @unique
  name          String
  nameBn        String?
  title         String
  bio           String   @db.Text
  rating        Float    @default(0)
  students      Int      @default(0)
  courses       Int      @default(0)
  verified      Boolean  @default(false)
  coursesTaught Course[]
}

model Book {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  title                 String
  titleBn               String?
  subtitle              String?
  description           String   @db.Text
  category              String
  author                String
  pages                 Int
  edition               String
  language              String   @default("Bn")
  publisher             String
  // Format availability is inferred from nullable prices:
  //   pdfPrice != null      → the online PDF can be purchased (requires SSLCOMMERZ)
  //   hardcopyPrice != null → the printed book can be purchased (SSLCOMMERZ or COD)
  // Both may be set (sold together) or exactly one.
  pdfPrice              Int?
  hardcopyPrice         Int?
  samplePages           Int      @default(12)
  students              Int      @default(0)
  rating                Float    @default(0)
  reviewCount           Int      @default(0)
  featured              Boolean  @default(false)
  published             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  seo                   Json?
  thumbnailUrl          String?
  demoPdfUrl            String? // short sample PDF (public — opened from the cover)
  pdfFileUrl            String? // full book PDF (owner-only, read in the secure viewer)
  allowedPaymentMethods String[] @default([])
  suggested             Json? // [{ type, id }] — empty = auto-suggest
}

// Exam package or standalone exam; hierarchy: package → subject → topic → questions
model Exam {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  title                 String
  titleBn               String?
  tagline               String
  description           String   @db.Text
  examType              String   @default("topic") // package | subject | topic
  difficulty            String   @default("Medium")
  isFree                Boolean  @default(false)
  priceAmount           Int      @default(0)
  priceOriginalAmount   Int?
  durationMinutes       Int      @default(0)
  questionsCount        Int      @default(0)
  totalMarks            Int      @default(0)
  negativeMarking       Boolean  @default(true)
  defaultNegativeMarks  Float    @default(0.25)
  marksPerQuestion      Int      @default(1)
  attemptCount          Int      @default(0)
  passRate              Float    @default(50)
  avgScore              Float    @default(0)
  rating                Float    @default(0)
  featured              Boolean  @default(false)
  published             Boolean  @default(false)
  createdAt             DateTime @default(now())
  seo                   Json?
  thumbnailUrl          String?
  allowedPaymentMethods String[] @default([])
  suggested             Json? // [{ type, id }] — empty = auto-suggest

  subjects ExamSubject[]
  attempts ExamAttempt[]

  @@index([published])
}

model ExamSubject {
  id        String      @id @default(cuid())
  exam      Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId    String
  title     String
  sortOrder Int         @default(0)
  topics    ExamTopic[]
}

model ExamTopic {
  id               String      @id @default(cuid())
  subject          ExamSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId        String
  title            String
  slug             String
  questionsCount   Int         @default(0)
  durationMinutes  Int         @default(0)
  marksPerQuestion Int         @default(1)
  negativeMarks    Float       @default(0.25)
  sortOrder        Int         @default(0)
  questions        Question[]

  @@unique([subjectId, slug])
}

model Question {
  id          String    @id @default(cuid())
  topic       ExamTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicId     String
  text        String    @db.Text
  options     Json // string[]
  answerIndex Int
  explanation String?
  sortOrder   Int       @default(0)

  @@index([topicId])
}

// ─── Blog ──────────────────────────────────────────────────────────
model BlogPost {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  excerpt      String
  category     String
  categoryBn   String?
  tags         String[] // PostgreSQL text[]
  author       String
  readMinutes  Int       @default(5)
  content      Json // BlogBlock[]
  featured     Boolean   @default(false)
  scheduledFor DateTime?
  published    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  seo          Json?
}

// ─── Commerce ──────────────────────────────────────────────────────
model Order {
  id               String    @id @default(cuid())
  orderNumber      Int?      @unique // human-friendly, starts at 34586
  // Guest checkout: userId is null until the guest registers and is merged.
  user             User?     @relation(fields: [userId], references: [id])
  userId           String?
  guestName        String?
  guestPhone       String?
  guestEmail       String?
  productType      String // course | book | exam
  productId        String
  productTitle     String
  variant          String? // pdf | hardcopy — books only; hardcopy is physical
  isPhysical       Boolean   @default(false)
  quantity         Int       @default(1)
  amount           Int // subtotal (unit price × quantity), excluding delivery
  deliveryCharge   Int       @default(0)
  total            Int       @default(0) // amount + deliveryCharge
  method           String    @default("SSLCOMMERZ") // legacy gateway field
  paymentMethod    String    @default("SSLCOMMERZ") // COD | SSLCOMMERZ
  status           String    @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  address          String?
  region           String? // DHAKA | OUTSIDE
  txId             String?   @unique
  gatewayReference String? // poll uses this
  refundedAt       DateTime?
  couponCode       String?
  discount         Int       @default(0)
  items            Json? // line items for multi-product (cart) orders
  // Steadfast courier (hardcopy delivery)
  consignmentId    String?
  trackingCode     String?
  courierStatus    String?
  createdAt        DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status])
  @@index([guestPhone])
  @@index([guestEmail])
}

// Discount coupons usable across courses, books and exams.
model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique // always stored upper-cased
  description String?
  type        String    @default("PERCENT") // PERCENT | FIXED
  value       Int // percent (1-100) for PERCENT, BDT for FIXED
  minSubtotal Int       @default(0)
  maxDiscount Int? // cap for PERCENT coupons
  appliesTo   String[]  @default([]) // empty = all; else subset of course|book|exam
  active      Boolean   @default(true)
  startsAt    DateTime?
  expiresAt   DateTime?
  usageLimit  Int? // null = unlimited
  usedCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active])
}

model Enrollment {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id])
  userId        String
  productType   String
  productId     String
  accessFrom    DateTime  @default(now())
  accessExpires DateTime?
  viaAdmin      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@unique([userId, productType, productId])
  @@index([userId])
}

// ─── Learning ──────────────────────────────────────────────────────
model ProgressItem {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  productId String
  lessonId  String? // for courses
  pageIndex Int? // for books
  percent   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, lessonId])
  @@index([userId, productId])
}

model ExamAttempt {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  exam        Exam     @relation(fields: [examId], references: [id])
  examId      String
  topicId     String?
  score       Float
  maxMarks    Float
  correct     Int
  wrong       Int
  unanswered  Int
  passed      Boolean
  answers     Json // user's selected answers snapshot
  startedAt   DateTime @default(now())
  submittedAt DateTime @default(now())

  @@index([userId, examId, submittedAt])
}

model Review {
  id          String   @id @default(cuid())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String? // null for admin-authored testimonials
  authorName  String? // display name when there is no linked user
  productType String // course | book | exam
  productId   String
  rating      Int
  text        String   @db.Text
  imageUrl    String? // optional photo attached to the review
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, productType, productId])
  @@index([productType, productId, status])
}

// ─── Site settings & dynamic content (CMS) ─────────────────────────
// Singleton row (id = "default") holding site-wide branding, SEO and
// delivery configuration. Fetched by the admin panel and the Next.js layout.
model SiteSetting {
  id                    String   @id @default("default")
  logoUrl               String?
  siteTitle             String   @default("Shohoz Skill")
  siteTitleBn           String?
  faviconUrl            String?
  metaDescription       String?  @db.Text
  ogImageUrl            String?
  keywords              String[] @default([])
  supportEmail          String?
  supportPhone          String?
  address               String?
  socials               Json?
  deliveryChargeDhaka   Int      @default(60)
  deliveryChargeOutside Int      @default(120)
  codEnabled            Boolean  @default(true)
  sslcommerzEnabled     Boolean  @default(true)
  reviewScrollSeconds   Int      @default(6) // auto-scroll interval for the reviews carousel
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Editable key/value JSON blocks for CMS-managed pages (home | about | contact).
model PageContent {
  id        String   @id @default(cuid())
  page      String   @unique // home | about | contact
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contact form submissions captured from the public Contact page.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  status    String   @default("NEW") // NEW | READ | REPLIED | ARCHIVED
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}
